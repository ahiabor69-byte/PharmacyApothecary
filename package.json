{
  "name": "apotheca-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first pharmacy retail manager",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && NODE_ENV=development electron .\"",
    "dev:web": "concurrently -k \"vite --host 127.0.0.1\" \"node server/index.cjs\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "migrate": "node scripts/migrate-legacy-db.cjs"
  },
  "dependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
